<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Territory.Application\Territory.Application.csproj" />
    <ProjectReference Include="..\Territory.Infrastructure\Territory.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="s13\*.docx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Update="appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>d76ca002-7f00-4cf0-acd2-4899e12f9a9f</UserSecretsId>
    <ClientRoot>$(MSBuildProjectDirectory)\..\..\client\</ClientRoot>
    <!-- wwwroot is generated by the Angular build during publish: evaluation-time globs would be stale. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Set SkipClientBuild=true to publish without rebuilding Angular (e.g. when CI builds it separately). -->
  <Target Name="PublishClientApp" AfterTargets="ComputeFilesToPublish">
    <Exec Command="node --version" ContinueOnError="true" StandardOutputImportance="low" Condition="'$(SkipClientBuild)' != 'true'">
      <Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
    </Exec>
    <Error Condition="'$(SkipClientBuild)' != 'true' And '$(NodeExitCode)' != '0'" Text="Node.js is required to build the Angular client. Install it from https://nodejs.org or set SkipClientBuild=true." />
    <Exec WorkingDirectory="$(ClientRoot)" Command="npm ci" Condition="'$(SkipClientBuild)' != 'true' And !Exists('$(ClientRoot)node_modules')" />
    <Exec WorkingDirectory="$(ClientRoot)" Command="npm run build -- --configuration production" Condition="'$(SkipClientBuild)' != 'true'" />
    <Error Condition="!Exists('wwwroot\index.html')" Text="wwwroot\index.html not found: the Angular client was not built." />

    <ItemGroup>
      <ClientDistFiles Include="wwwroot\**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(ClientDistFiles.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
